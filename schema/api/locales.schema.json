{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/getbible/v1_bookmark_builder/schema/api/locales.schema.json",
  "title": "v1/locales.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "locales"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "topics"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$",
            "maxLength": 16
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "topics": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
