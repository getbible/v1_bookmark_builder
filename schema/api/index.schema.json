{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/getbible/v1_bookmark_builder/schema/api/index.schema.json",
  "title": "v1/index.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "checksum",
    "counts",
    "resources",
    "locales"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "verses",
        "locales"
      ],
      "properties": {
        "topics": {
          "type": "integer",
          "minimum": 0
        },
        "verses": {
          "type": "integer",
          "minimum": 0
        },
        "locales": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$",
        "maxLength": 16
      }
    }
  },
  "description": "Discovery document. checksum is the SHA-256 of all.json; catalog_version increments whenever that checksum changes between published builds."
}
