{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/getbible/v1_bookmark_builder/schema/api/checksums.schema.json",
  "title": "v1/checksums.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
